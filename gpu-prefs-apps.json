{
  "apps": [
    {
      "name": "Brave Browser",
      "paths": [
        "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
      ]
    },
    {
      "name": "Discord",
      "base": "%LOCALAPPDATA%\\Discord",
      "patterns": [
        "Update.exe",
        "app-*\\Discord.exe",
        "app-*\\modules\\discord_utils-*\\discord_utils\\DiscordSystemHelper.exe"
      ]
    },
    {
      "name": "Medal",
      "base": "%LOCALAPPDATA%\\Medal",
      "patterns": [
        "Medal.exe",
        "app-*\\Medal.exe"
      ]
    },
    {
      "name": "Spotify",
      "paths": [
        "%APPDATA%\\Spotify\\Spotify.exe",
        "%APPDATA%\\Spotify\\SpotifyLauncher.exe"
      ]
    }
  ]
}
